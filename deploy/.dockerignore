# ─────────────────────────────────────────────────────────────
#  Keep the build context tiny — speeds up `docker build`
#  and avoids leaking secrets / mongo data into the image.
# ─────────────────────────────────────────────────────────────

# Mongo data dir + journals (huge, never needed in API image)
docker/mongodb/

# Raw + intermediate data (only data/preprocessed/ is copied in)
data/raw_data/
data/preprocessed/*.csv
notebooks/

# Reports / EDA artefacts
reports/
*.png
*.docx
*.ipynb

# Python / build noise
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Editor / OS noise
.vscode/
.idea/
.DS_Store

# Git
.git/
.gitignore

# Logs
logs/
*.log

# Local secrets — never bake into images
.env
.env.*
*.pem
*.key
